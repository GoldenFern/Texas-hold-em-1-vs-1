# Heads-Up Lab — 环境变量模板
# 复制为 .env 后填入真实 Key；.env 已被 gitignore。
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# ── LLM Providers ────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
LONGCAT_API_KEY=
MIMO_API_KEY=
FOURROUTER_API_KEY=

# ── Server ───────────────────────────────────────────────────────
# HU_HOST=127.0.0.1
# HU_PORT=5050
# HU_SECRET_KEY=
# HU_CONNECT_TIMEOUT=20
# HU_READ_TIMEOUT=300
# HU_ALLOWED_ORIGINS=http://127.0.0.1:5050,http://localhost:5050,http://127.0.0.1:5173,http://localhost:5173

# ── Debug ────────────────────────────────────────────────────────
# HU_LLM_LOG_TRAFFIC=1
